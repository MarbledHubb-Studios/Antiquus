{
  "multipart": [
    {
      "apply": {
        "model": "antiquus:block/old_moss_carpet"
      },
      "when": {
        "bottom": "true"
      }
    },
    {
      "apply": {
        "model": "antiquus:block/old_moss_carpet"
      },
      "when": {
        "bottom": "false",
        "east": "none",
        "north": "none",
        "south": "none",
        "west": "none"
      }
    },
    {
      "apply": {
        "model": "antiquus:block/old_moss_carpet_side"
      },
      "when": {
        "north": "low"
      }
    },
    {
      "apply": {
        "model": "antiquus:block/old_moss_carpet_side",
        "uvlock": true,
        "y": 90
      },
      "when": {
        "east": "low"
      }
    },
    {
      "apply": {
        "model": "antiquus:block/old_moss_carpet_side",
        "uvlock": true,
        "y": 180
      },
      "when": {
        "south": "low"
      }
    },
    {
      "apply": {
        "model": "antiquus:block/old_moss_carpet_side",
        "uvlock": true,
        "y": 270
      },
      "when": {
        "west": "low"
      }
    }
  ]
}